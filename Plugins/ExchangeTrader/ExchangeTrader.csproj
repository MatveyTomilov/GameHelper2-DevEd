<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../GameHelper/GameHelper.csproj" Private="false" />
  </ItemGroup>
  <Target Name="StagePlugin" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="../../GameHelper/$(OutDir)Plugins/ExchangeTrader" SkipUnchangedFiles="true" />
  </Target>
</Project>
